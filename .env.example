# Environment variables billwright reads. Both are optional, and nothing loads
# this file for you: export them in your shell, or pass the matching flag.

# The company profile directory. Precedence: --profile, then this, then
# [tool.billwright] profile in pyproject.toml, then ./data, then ./example.
BILLWRIGHT_PROFILE=

# Where `--archive` writes the ten-year record. Precedence: --archive-dir, then
# this, then [tool.billwright] archive, then <profile>/archive.
BILLWRIGHT_ARCHIVE=
