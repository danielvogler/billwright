{#
  Shared document shell. The wordmark is typeset in HTML rather than embedded as
  an image, so it stays vector-sharp and in step with the document; a drawn mark,
  if brand.toml names one, is embedded beside it (see _wordmark.html.j2).
#}
<!DOCTYPE html>
<html lang="{{ language }}">
  <head>
    <meta charset="utf-8" />
    <title>{% block title %}{% endblock %}</title>
    <meta name="author" content="{{ company.name }}" />
    <meta name="generator" content="billwright {{ billwright_version }}" />
    {% if provenance %}
    <meta name="{{ provenance_key }}" content="{{ provenance }}" />
    {% endif %}
  </head>
  <body>
    {% block body %}{% endblock %}
  </body>
</html>
